# Copy this file to .streamlit/secrets.toml and replace both placeholders.
# Streamlit Community Cloud: paste the same two lines into the app's Secrets field.
# Do not commit .streamlit/secrets.toml. It is gitignored.

APP_PASSWORD = "replace-with-a-long-password"
GEMINI_API_KEY = "replace-with-your-google-ai-studio-key"
